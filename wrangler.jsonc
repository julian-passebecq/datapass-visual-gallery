{
  "name": "datapass-visual-gallery",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-09",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true },
  "r2_buckets": [
    { "binding": "PRIVATE_MEDIA", "bucket_name": "datapass-media" },
    { "binding": "WEB_ASSETS", "bucket_name": "datapass-web-assets" }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "PUBLIC_ORIGIN": ""
  }
}
